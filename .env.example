# Copy this file to .env and fill in your values.
# docker-compose.yml reads from .env automatically.

# ── Domain (used by Traefik) ──────────────────────────────────────────────────
DOMAIN_NAME=yourdomain.com
SUBDOMAIN=nutriverse-api

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres

# ── PostgREST authenticator role password ─────────────────────────────────────
# Must match the password set during DB init (docker/init/01_roles.sh)
AUTHENTICATOR_PASSWORD=change-me
